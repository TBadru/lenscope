{
  "name": "Lenscope",
  "displayName": "lenscope",
  "description": "a fuzzy finder over lists (ripgrep) VS code extension",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:lenscope.live_grep",
    "onCommand:lenscope.find_files",
    "onCommand:lenscope.current_buffer_fuzzy_find"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lenscope.live_grep",
        "title": "Lenscope: live grep"
      },
      {
        "command": "lenscope.find_files",
        "title": "Lenscope: find files"
      },
      {
        "command": "lenscope.current_buffer_fuzzy_find",
        "title": "Lenscope: current buffer fuzzy find"
      }
    ],
    "keybindings": [
      {
        "command": "lenscope.live_grep",
        "key": "cmd+shift+l",
        "when": "editorTextFocus"
      },
      {
        "command": "lenscope.find_files",
        "key": "cmd+shift+f",
        "when": "editorTextFocus"
      },
      {
        "command": "lenscope.current_buffer_fuzzy_find",
        "key": "cmd+shift+c",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.106.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "fuse.js": "^7.1.0"
  }
}