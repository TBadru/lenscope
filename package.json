{
  "name": "Lenscope",
  "displayName": "lenscope",
  "description": "a fuzzy finder over lists (ripgrep) VS code extension",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:lenscope.live_grep",
    "onCommand:lenscope.find_files",
    "onCommand:lenscope.current_buffer_fuzzy_find"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lenscope.live_grep",
        "title": "Lenscope: live grep"
      },
      {
        "command": "lenscope.find_files",
        "title": "Lenscope: find files"
      },
      {
        "command": "lenscope.current_buffer_fuzzy_find",
        "title": "Lenscope: current buffer fuzzy find"
      }
    ],
    "keybindings": [
      {
        "command": "lenscope.live_grep",
        "key": "cmd+shift+l",
        "when": "editorTextFocus"
      },
      {
        "command": "lenscope.find_files",
        "key": "cmd+shift+f",
        "when": "editorTextFocus"
      },
      {
        "command": "lenscope.current_buffer_fuzzy_find",
        "key": "cmd+shift+c",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@types/vscode": "1.120.0",
    "@vitest/coverage-v8": "4.1.9",
    "@vscode/test-electron": "3.0.0",
    "esbuild": "0.28.1",
    "eslint": "10.5.0",
    "npm-run-all": "4.1.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "fuse.js": "7.4.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
